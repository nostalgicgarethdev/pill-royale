# Copy this to .env or set on your hosting platform (never commit real values)
CLUSTER=mainnet-beta
PRIZE_SOL=0.1

# Your mainnet treasury wallet private key (base58)
# Get this by exporting the secret key from Phantom / Solflare etc.
TREASURY_SECRET=your_base58_private_key_here

# PORT is usually provided automatically by the platform
# PORT=3000